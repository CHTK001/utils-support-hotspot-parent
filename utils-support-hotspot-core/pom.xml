<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>utils-support-hotspot-parent</artifactId>
        <version>4.0.0.33</version>
    </parent>

    <artifactId>utils-support-hotspot-core</artifactId>
    <name>Utils Support Hotspot Core - 热点监控核心模块</name>
    <description>
        Utils Support Hotspot Core - 热点监控核心模块

        该模块提供专业的功能支持和工具集成。

        主要特性：
        - 🔧 功能完整：提供完整的功能实现
        - 🚀 性能优化：高性能的实现方案
        - 🛡️ 稳定可靠：经过充分测试和验证
        - 📚 文档完善：详细的使用文档和示例
        - 🔄 易于集成：简单的 API 和配置方式

        适用场景：
        - 企业级应用开发
        - 系统集成项目
        - 工具链构建
        - 第三方服务集成
    </description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <hotswap-agent.version>1.4.1</hotswap-agent.version>
    </properties>

    <dependencies>
        <!-- Spy 桥接模块：Bootstrap CL 注入的零依赖桥接层（provided - 运行时由 Bootstrap CL 加载） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-hotspot-spy</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- HotswapAgent 核心依赖 -->
        <dependency>
            <groupId>org.hotswapagent</groupId>
            <artifactId>hotswap-agent-core</artifactId>
            <version>${hotswap-agent.version}</version>
        </dependency>
        <!-- ByteBuddy：字节码增强库 -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.14.10</version>
        </dependency>

        <!-- ByteBuddy Agent：Java代理支持 -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <version>1.14.10</version>
        </dependency>

        <!-- Javassist：字节码操作库 -->
        <dependency>
            <groupId>org.javassist</groupId>
            <artifactId>javassist</artifactId>
            <version>3.29.2-GA</version>
        </dependency>

        <!-- Jackson：JSON处理库 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.16.1</version>
        </dependency>

        <!-- FastJSON：高性能JSON处理库 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>1.2.83</version>
        </dependency>

        <!-- Java-WebSocket：WebSocket客户端和服务器库 -->
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.4</version>
        </dependency>

        <!-- RSocket：响应式通信协议 -->
        <dependency>
            <groupId>io.rsocket</groupId>
            <artifactId>rsocket-core</artifactId>
            <version>1.1.3</version>
        </dependency>

        <!-- RSocket Netty Transport -->
        <dependency>
            <groupId>io.rsocket</groupId>
            <artifactId>rsocket-transport-netty</artifactId>
            <version>1.1.3</version>
        </dependency>

        <!-- Reactor：响应式编程库 -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>3.5.11</version>
        </dependency>

        <!-- Commons IO：IO工具库 -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.16.1</version>
        </dependency>

        <!-- Commons Lang：语言工具库 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.14.0</version>
        </dependency>

        <!-- SLF4J：日志门面 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.11</version>
        </dependency>

        <!-- Logback：日志实现 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.3.14</version>
        </dependency>

        <!-- SQLite JDBC：SQLite 数据库驱动 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.0.0</version>
        </dependency>

        <!-- JUnit 5 测试框架 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 复制依赖到 target 目录 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <!-- 复制 hotspot 插件模块到 plugins 目录 -->
                    <execution>
                        <id>copy-plugins</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/plugins</outputDirectory>
                            <includeGroupIds>com.chua</includeGroupIds>
                            <excludeArtifactIds>utils-support-hotspot-core,utils-support-hotspot-spy</excludeArtifactIds>
                            <excludeTransitive>true</excludeTransitive>
                        </configuration>
                    </execution>
                    <!-- 复制所有三方依赖到 libs 目录 -->
                    <execution>
                        <id>copy-libs</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <excludeGroupIds>com.chua</excludeGroupIds>
                            <excludeScope>provided</excludeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 复制打包产出物到父项目的 output 目录 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-to-output</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- 创建 output 目录 -->
                                <mkdir dir="${basedir}/../output"/>
                                <mkdir dir="${basedir}/../output/plugins"/>
                                <mkdir dir="${basedir}/../output/libs"/>

                                <!-- 复制 core jar 到 libs 目录 -->
                                <copy todir="${basedir}/../output/libs">
                                    <fileset dir="${project.build.directory}">
                                        <include name="${project.artifactId}-${project.version}.jar"/>
                                    </fileset>
                                </copy>

                                <!-- 复制 spy jar 到 output 根目录 -->
                                <copy todir="${basedir}/../output">
                                    <fileset dir="${basedir}/../utils-support-hotspot-spy/target">
                                        <include name="spy.jar"/>
                                    </fileset>
                                </copy>

                                <!-- 复制 plugins 目录（目录可能不存在，如无插件依赖时） -->
                                <copy todir="${basedir}/../output/plugins" failonerror="false">
                                    <fileset dir="${project.build.directory}/plugins" erroronmissingdir="false">
                                        <include name="**/*.jar"/>
                                    </fileset>
                                </copy>

                                <!-- 复制 libs 目录（三方依赖） -->
                                <copy todir="${basedir}/../output/libs" failonerror="false">
                                    <fileset dir="${project.build.directory}/libs" erroronmissingdir="false">
                                        <include name="**/*.jar"/>
                                    </fileset>
                                </copy>

                                <echo message="Core 依赖已复制到: ${basedir}/../output"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
