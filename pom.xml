<?xml version="1.0" encoding="UTF-8"?>
<!--
    热点监控父模块 - utils-support-hotspot-parent

    该模块是Java应用热点监控和性能分析的父级POM，提供运行时监控和诊断功能

    主要功能：
    - Java Agent：基于字节码增强的运行时监控代理
    - 性能监控：实时监控应用性能指标和热点方法
    - 组件监控：针对各种中间件和框架的专项监控
    - 热部署：支持代码热替换和动态更新
    - 可视化：提供Web UI界面展示监控数据

    监控组件：
    - 数据库：MySQL、MyBatis、P6Spy SQL监控
    - 缓存：Redis缓存操作监控
    - 消息队列：Kafka、RabbitMQ消息监控
    - Web服务器：Tomcat、Undertow容器监控
    - 网络通信：Netty、OkHttp、HttpClient网络监控
    - 序列化：FastJSON、Jackson序列化监控
    - 分布式：Zookeeper、Dubbo3.x分布式服务监控
    - 框架：Spring、Javax、Jakarta企业级框架监控
    - 日志：Logger日志系统监控

    技术特点：
    - 基于Java 8兼容性设计
    - 使用ByteBuddy和Javassist字节码操作
    - 支持运行时动态增强
    - 低侵入性监控方案

    版本：4.0.0.42
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目基本信息 -->
    <groupId>com.chua</groupId>
    <artifactId>utils-support-hotspot-parent</artifactId>
    <packaging>pom</packaging>
    <version>4.0.0.42</version>

    <!-- 子模块列表：各种热点监控组件 -->
    <modules>
        <!-- 核心模块 -->
        <!-- Spy：Bootstrap CL 桥接模块（零依赖，注入Bootstrap CL） -->
        <module>utils-support-hotspot-spy</module>
        <!-- Agent：Java代理核心模块 -->
        <module>utils-support-hotspot-agent</module>
        <!-- Core：监控核心功能模块 -->
        <module>utils-support-hotspot-core</module>
        <!-- UI：Web界面展示模块（已禁用，使用独立 Vue 项目测试）-->
        <module>utils-support-hotspot-ui</module>

        <!-- 数据库监控 -->
        <!-- P6Spy：SQL语句监控 -->
        <module>utils-support-hotspot-p6spy</module>
        <!-- Jedis：Jedis缓存监控 -->
        <module>utils-support-hotspot-jedis</module>
        <!-- Dragonfly：Dragonfly缓存监控 -->
        <module>utils-support-hotspot-dragonfly</module>
        <!-- Lettuce：Lettuce缓存监控 -->
        <module>utils-support-hotspot-lettuce</module>
        <!-- MyBatis：MyBatis ORM监控 -->
        <module>utils-support-hotspot-mybatis</module>
        <!-- MySQL：MySQL数据库监控 -->
        <module>utils-support-hotspot-mysql</module>
        <!-- PostgreSQL：PostgreSQL数据库监控 -->
        <module>utils-support-hotspot-pgsql</module>
        <!-- Oracle：Oracle数据库监控 -->
        <module>utils-support-hotspot-oracle</module>
        <!-- SQL Server：SQL Server数据库监控 -->
        <module>utils-support-hotspot-sqlserver</module>
        <!-- HikariCP：HikariCP连接池监控 -->
        <!-- HikariCP：连接池监控（已被 ByteBuddy 替代，编译失败，临时禁用）
        <module>utils-support-hotspot-hikaricp</module> -->

        <!-- Web服务器监控 -->
        <!-- Tomcat9x：Tomcat 9.x容器监控 -->
        <module>utils-support-hotspot-tomcat9x</module>
        <!-- Tomcat10x：Tomcat 10.x容器监控 -->
        <module>utils-support-hotspot-tomcat10x</module>
        <!-- Undertow：Undertow容器监控 -->
        <module>utils-support-hotspot-undertow</module>
        <!-- Jetty：Jetty容器监控 -->
        <module>utils-support-hotspot-jetty</module>

        <!-- 分布式服务监控 -->
        <!-- Zookeeper：Zookeeper协调服务监控 -->
        <module>utils-support-hotspot-zookeeper</module>
        <!-- Dubbo3x：Dubbo3.x微服务监控 -->
        <module>utils-support-hotspot-dubbo3x</module>
        <!-- Dubbo2x：Dubbo2.x微服务监控 -->
        <module>utils-support-hotspot-dubbo2x</module>

        <!-- 网络通信监控 -->
        <!-- Netty：Netty网络框架监控 -->
        <module>utils-support-hotspot-netty</module>
        <!-- OkHttp：OkHttp客户端监控 -->
        <module>utils-support-hotspot-okhttp</module>
        <!-- HttpClient 3.x：Apache Commons HttpClient 3.x监控 -->
        <module>utils-support-hotspot-httpclient3x</module>
        <!-- HttpClient 4.x：Apache HttpClient 4.x监控 -->
        <module>utils-support-hotspot-httpclient4x</module>
        <!-- HttpClient 5.x：Apache HttpClient 5.x监控 -->
        <module>utils-support-hotspot-httpclient5x</module>

        <!-- 序列化监控 -->
        <!-- FastJSON：FastJSON序列化监控 -->
        <module>utils-support-hotspot-fastjson</module>
        <!-- Jackson：Jackson序列化监控 -->
        <module>utils-support-hotspot-jackson</module>

        <!-- 消息队列监控 -->
        <!-- Kafka：Kafka消息队列监控 -->
        <module>utils-support-hotspot-kafka</module>
        <!-- RabbitMQ：RabbitMQ消息队列监控 -->
        <module>utils-support-hotspot-rabbit</module>

        <!-- 系统监控 -->
        <!-- Logger：日志系统监控 -->
        <module>utils-support-hotspot-logger</module>
        <!-- Spring5x：Spring 5.x框架监控 -->
        <module>utils-support-hotspot-spring5x</module>
        <!-- Spring6x：Spring 6.x框架监控 -->
        <module>utils-support-hotspot-spring6x</module>

        <!-- 热部署 -->
        <!-- HotSwap：代码热替换功能 -->
        <module>utils-support-hotspot-hotswap</module>

        <!-- JVM 性能监控 -->
        <!-- JFR：JDK Flight Recorder 集成 -->
        <module>utils-support-hotspot-jfr</module>

        <!-- 微服务监控 -->
        <!-- Nacos：Nacos 服务注册与配置中心监控 -->
        <module>utils-support-hotspot-nacos</module>

        <!-- 指标监控 -->
        <!-- Micrometer：Micrometer 指标监控 -->
        <module>utils-support-hotspot-micrometer</module>

        <!-- 性能分析 -->
        <!-- Profiler：慢方法分析模块 -->
        <module>utils-support-hotspot-profiler</module>

        <!-- 测试 -->
        <!-- TestAgent：Agent测试程序（验证FastMethodHelper和AgentSelfMonitor） -->
        <module>utils-support-hotspot-test-agent</module>
        <!-- TestSpringBoot A：服务A（调用方，端口18081）- 链路追踪测试 -->
        <module>utils-support-hotspot-test-springboot-a</module>
        <!-- TestSpringBoot B：服务B（被调用方，端口18082）- 链路追踪测试 -->
        <module>utils-support-hotspot-test-springboot-b</module>
    </modules>

    <!-- 项目属性配置 -->
    <properties>
        <!-- Java版本：使用Java 8保证最大兼容性 -->
        <java.version>8</java.version>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <!-- 项目编码：统一使用UTF-8编码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Agent主类：Java Agent的premain方法入口 -->
        <premain>com.chua.hotspot.agent.support.Agent</premain>
        <!-- ByteBuddy：统一版本管理，覆盖父/子模块的不同版本 -->
        <bytebuddy.version>1.17.8</bytebuddy.version>
    </properties>

    <!-- 公共依赖：所有热点监控子模块都会继承 -->
    <dependencies>
        <!-- Lombok：简化Java代码编写，编译时生成代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.42</version>
            <scope>provided</scope>
        </dependency>

        <!-- ByteBuddy：Java字节码操作库，用于运行时代码增强 -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>${bytebuddy.version}</version>
        </dependency>

        <!-- ByteBuddy Agent：ByteBuddy的Agent支持库 -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <version>${bytebuddy.version}</version>
        </dependency>

        <!-- Javassist：Java字节码操作工具，用于动态修改类 -->
        <dependency>
            <groupId>org.javassist</groupId>
            <artifactId>javassist</artifactId>
            <version>3.30.2-GA</version>
        </dependency>
    </dependencies>

    <!-- 构建配置 -->
    <build>
        <plugins>
            <!-- Maven编译插件：配置Java 8编译参数 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- 源代码兼容性：Java 8 -->
                    <source>8</source>
                    <!-- 目标字节码版本：Java 8 -->
                    <target>8</target>
                    <!-- 注解处理器配置：确保Lombok正常工作 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.42</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!--
                Maven Antrun Plugin：聚合所有子模块构建产物到父项目 output/ 目录
                解决以下问题：
                - core 模块的 copy-plugins 只复制 core 自身依赖，不包含其他子模块 jar
                - 用户需要在每个子模块手动 mvn install 才能被 core 看到
                - 现在：任意子模块构建后自动复制到 output/plugins/ 和 output/java8/
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>aggregate-output-plugins</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- 创建聚合目录 -->
                                <mkdir dir="${maven.multiModuleProjectDirectory}/output"/>
                                <mkdir dir="${maven.multiModuleProjectDirectory}/output/plugins"/>
                                <mkdir dir="${maven.multiModuleProjectDirectory}/output/java8"/>

                                <!--
                                    遍历所有子模块：复制 utils-support-hotspot-* 的 jar 到 output/plugins/
                                    排除 utils-support-hotspot-core、utils-support-hotspot-spy（这两个由 core 模块的 copy-to-output 处理）
                                    排除 utils-support-hotspot-test-* 与 utils-support-hotspot-agent（agent 由 java8 profile 自己处理，test-* 不需要）
                                -->
                                <copy todir="${maven.multiModuleProjectDirectory}/output/plugins" failonerror="false">
                                    <fileset dir="${maven.multiModuleProjectDirectory}">
                                        <include name="utils-support-hotspot-*/target/utils-support-hotspot-*-4.0.0.42.jar"/>
                                        <exclude name="utils-support-hotspot-core/target/**"/>
                                        <exclude name="utils-support-hotspot-spy/target/**"/>
                                        <exclude name="utils-support-hotspot-agent/target/**"/>
                                        <exclude name="utils-support-hotspot-test-*/target/**"/>
                                        <exclude name="utils-support-hotspot-ui/target/**"/>
                                    </fileset>
                                </copy>

                                <echo message="已聚合所有子模块 jar 到: ${maven.multiModuleProjectDirectory}/output/plugins"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- 分发管理：配置Maven仓库发布地址 -->
<distributionManagement>
        <repository>
            <id>2676178-release-jmLEdB</id>
            <url>https://packages.aliyun.com/6a62fa1d287d37b037a68ee8/maven/2676178-release-jmledb</url>
        </repository>
        <snapshotRepository>
            <id>2676178-snapshot-FwAJpk</id>
            <url>https://packages.aliyun.com/6a62fa1d287d37b037a68ee8/maven/2676178-snapshot-fwajpk</url>
        </snapshotRepository>
    </distributionManagement>
</project>
