    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <!-- 复制 hotspot 插件模块到 plugins 目录 -->
                    <execution>
                        <id>copy-plugins</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/plugins</outputDirectory>
                            <includeGroupIds>com.chua</includeGroupIds>
                            <excludeArtifactIds>utils-support-hotspot-core</excludeArtifactIds>
                            <excludeTransitive>true</excludeTransitive>
                        </configuration>
                    </execution>
                    <!-- 复制所有三方依赖到 libs 目录 -->
                    <execution>
                        <id>copy-libs</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <excludeGroupIds>com.chua</excludeGroupIds>
                            <excludeArtifactIds>byte-buddy,byte-buddy-agent,javassist,lombok</excludeArtifactIds>
                            <!-- 排除 provided scope 的依赖（如 Tomcat、Servlet API 等） -->
                            <excludeScope>provided</excludeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Spring Boot Plugin - Not needed for Java Agent -->
            <!--
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.0.2</version>
            </plugin>
            -->

            <!-- Shade Plugin - Disabled, using Assembly Plugin instead -->
            <!--
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <artifactSet>
                        <includes>
                            <dependency>commons-io:commons-io:2.16.1</dependency>
                        </includes>
                    </artifactSet>
                </configuration>
            </plugin>
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!-- 使用自定义描述符，排除可能冲突的库（Tomcat、Spring、Netty 等） -->
                    <descriptors>
                        <descriptor>src/assembly/agent-jar.xml</descriptor>
                    </descriptors>
                    <finalName>${project.artifactId}-${project.version}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                    <archive>
                        <manifestEntries>
                            <Premain-Class>${premain}</Premain-Class>
                            <Agent-Class>${premain}</Agent-Class>
                            <Can-Retransform-Classes>true</Can-Retransform-Classes>
                            <Can-Redefine-Classes>true</Can-Redefine-Classes>
                            <Build-By>CH</Build-By>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <!-- 生成 Agent JAR -->
                    <execution>
                        <id>make-agent-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                    <!-- 生成分发包（包含 lib 目录） -->
                    <execution>
                        <id>make-distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/distribution.xml</descriptor>
                            </descriptors>
                            <finalName>${project.artifactId}-${project.version}</finalName>
                            <appendAssemblyId>true</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>

            <!-- 复制打包产出物到父项目的 output 目录 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-shared-to-output</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- 创建 output 目录（不清理，因为多个 profile 会共用） -->
                                <mkdir dir="${basedir}/../output"/>
                                <mkdir dir="${basedir}/../output/plugins"/>
                                <mkdir dir="${basedir}/../output/libs"/>
                                
                                <!-- 复制共用的 plugins 目录 -->
                                <copy todir="${basedir}/../output/plugins">
                                    <fileset dir="${project.build.directory}/plugins">
                                        <include name="**/*.jar"/>
                                    </fileset>
                                </copy>
                                
                                <!-- 复制共用的 libs 目录 -->
                                <copy todir="${basedir}/../output/libs">
                                    <fileset dir="${project.build.directory}/libs">
                                        <include name="**/*.jar"/>
                                    </fileset>
                                </copy>
                                
                                <echo message="共用依赖已复制到: ${basedir}/../output"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    
    <!-- Maven Profiles for different Java versions -->
    <profiles>
        <!-- Java 8 Profile (default) -->
        <profile>
            <id>java8</id>
            <activation>
                <activeByDefault>true</activeByDefault>
