                <maven.compiler.target>8</maven.compiler.target>
                <maven.compiler.release>8</maven.compiler.release>
                <agent.classifier>java8</agent.classifier>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.4.1</version>
                        <configuration>
                            <classifier>${agent.classifier}</classifier>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <configuration>
                            <finalName>${project.artifactId}-${project.version}-${agent.classifier}</finalName>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-to-output-java8</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <!-- 只复制 agent jar 到版本特定目录 -->
                                        <mkdir dir="${basedir}/../output/${agent.classifier}"/>
                                        <copy todir="${basedir}/../output/${agent.classifier}">
                                            <fileset dir="${project.build.directory}">
                                                <include name="${project.artifactId}-${project.version}-${agent.classifier}.jar"/>
                                            </fileset>
                                        </copy>
                                        <echo message="Java 8 agent 已复制到: ${basedir}/../output/${agent.classifier}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
