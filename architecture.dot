digraph G {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", shape=box, style="rounded,filled"];
    edge [fontname="Helvetica", fontsize=10];

    // =============== JVM 运行时 ===============
    subgraph cluster_jvm {
        label="目标 JVM 应用 (Java 8/17/21)";
        style="rounded,dashed";
        color="#888";
        jre [label="java -javaagent:hotspot-agent.jar", fillcolor="#fde2e1"];
    }

    // =============== Agent 薄壳 ===============
    subgraph cluster_agent {
        label="utils-support-hotspot-agent";
        style="rounded,filled";
        fillcolor="#fff4d6";
        premain [label="com.chua.hotspot.agent.support.Agent\n(premain/agent)", fillcolor="#ffd54f"];
        asm     [label="maven-assembly-plugin\n零依赖薄壳 jar", fillcolor="#ffe082"];
        premain -> asm [style=dotted];
    }

    // =============== Spy 桥接 ===============
    subgraph cluster_spy {
        label="utils-support-hotspot-spy (Bootstrap CL 注入)";
        style="rounded,filled";
        fillcolor="#e3f2fd";
        spy [label="com.chua.hotspot.spy.Spy\n+ SpyHandler", fillcolor="#90caf9"];
        bcl [label="appendToBootstrapClassLoaderSearch", shape=note, fillcolor="#bbdefb"];
        spy -> bcl [style=dotted, label="注入"];
    }

    // =============== Core 核心引擎 ===============
    subgraph cluster_core {
        label="utils-support-hotspot-core (核心引擎)";
        style="rounded,filled";
        fillcolor="#e8f5e9";
        bb   [label="ByteBuddy 1.14.10", fillcolor="#a5d6a7"];
        jc   [label="Javassist 3.29.2-GA", fillcolor="#a5d6a7"];
        hs   [label="HotswapAgent 1.4.1", fillcolor="#a5d6a7"];
        fmh  [label="FastMethodHelper\n(双引擎)", fillcolor="#81c784"];
        tsd  [label="追踪/日志/指标存储\nSQLite + RingBuffer", fillcolor="#81c784"];
        api  [label="Agent HTTP API\n/agent/trace | /agent/log\n/agent/hotswap | /agent/thread\n/agent/table_info", shape=note, fillcolor="#c8e6c9"];
        ws   [label="WebSocket / RSocket\n推送通道", fillcolor="#c8e6c9"];
    }

    // =============== 插件族 ===============
    subgraph cluster_plugins {
        label="插件模块 (均依赖 core)";
        style="rounded,filled";
        fillcolor="#f3e5f5";
        node [fillcolor="#ce93d8"];

        subgraph cluster_db {
            label="数据库";
            style="rounded";
            p_p6spy     [label="p6spy"];
            p_mybatis   [label="mybatis"];
            p_mysql     [label="mysql"];
            p_pgsql     [label="pgsql"];
            p_oracle    [label="oracle"];
            p_sqlserver [label="sqlserver"];
            p_hikaricp  [label="hikaricp"];
        }

        subgraph cluster_cache {
            label="缓存";
            style="rounded";
            p_jedis     [label="jedis"];
            p_lettuce   [label="lettuce"];
            p_dragonfly [label="dragonfly"];
        }

        subgraph cluster_web {
            label="Web 容器";
            style="rounded";
            p_tc9   [label="tomcat9x"];
            p_tc10  [label="tomcat10x"];
            p_under [label="undertow"];
            p_jetty [label="jetty"];
        }

        subgraph cluster_net {
            label="网络";
            style="rounded";
            p_netty   [label="netty"];
            p_okhttp  [label="okhttp"];
            p_hc3     [label="httpclient3x"];
            p_hc4     [label="httpclient4x"];
            p_hc5     [label="httpclient5x"];
        }

        subgraph cluster_ser {
            label="序列化";
            style="rounded";
            p_fastjson [label="fastjson"];
            p_jackson  [label="jackson"];
        }

        subgraph cluster_mq {
            label="消息队列";
            style="rounded";
            p_kafka  [label="kafka"];
            p_rabbit [label="rabbit"];
        }

        subgraph cluster_rpc {
            label="分布式";
            style="rounded";
            p_zk     [label="zookeeper"];
            p_nacos  [label="nacos"];
            p_dubbo2 [label="dubbo2x"];
            p_dubbo3 [label="dubbo3x"];
        }

        subgraph cluster_fw {
            label="框架";
            style="rounded";
            p_logger [label="logger"];
            p_sp5    [label="spring5x"];
            p_sp6    [label="spring6x"];
        }

        subgraph cluster_os {
            label="JVM/指标/热部署";
            style="rounded";
            p_jfr   [label="jfr"];
            p_mic   [label="micrometer"];
            p_prof  [label="profiler"];
            p_hot   [label="hotswap"];
        }
    }

    // =============== 测试 ===============
    subgraph cluster_test {
        label="测试与示例";
        style="rounded,filled";
        fillcolor="#fff3e0";
        t_agent [label="test-agent", fillcolor="#ffcc80"];
        t_a     [label="test-springboot-a\n:18081", fillcolor="#ffcc80"];
        t_b     [label="test-springboot-b\n:18082", fillcolor="#ffcc80"];
        t_a -> t_b [label="HTTP"];
    }

    // =============== 关系 ===============
    jre      -> premain   [label="-javaagent"];
    premain  -> spy       [label="注入 Bootstrap CL", style=dashed, color="#1565c0"];
    premain  -> core      [label="反射加载\n(无静态依赖)", style=dashed, color="#2e7d32"];
    spy      -> core      [label="Spy.x() 路由回调", style=dotted, color="#1565c0"];
    core     -> bb; core -> jc; core -> hs; core -> fmh; core -> tsd; core -> api; core -> ws;

    // core 暴露给所有插件
    {rank=same; bb; jc; hs; fmh; tsd; api; ws;}

    // 核心到插件的依赖（聚合边，简化为：core -> 子 cluster）
    core -> p_p6spy [style=dashed, color="#2e7d32"];
    core -> p_mybatis [style=dashed, color="#2e7d32"];
    core -> p_mysql [style=dashed, color="#2e7d32"];
    core -> p_pgsql [style=dashed, color="#2e7d32"];
    core -> p_oracle [style=dashed, color="#2e7d32"];
    core -> p_sqlserver [style=dashed, color="#2e7d32"];
    core -> p_hikaricp [style=dashed, color="#2e7d32"];
    core -> p_jedis [style=dashed, color="#2e7d32"];
    core -> p_lettuce [style=dashed, color="#2e7d32"];
    core -> p_dragonfly [style=dashed, color="#2e7d32"];
    core -> p_under [style=dashed, color="#2e7d32"];
    core -> p_jetty [style=dashed, color="#2e7d32"];
    core -> p_zk [style=dashed, color="#2e7d32"];
    core -> p_nacos [style=dashed, color="#2e7d32"];
    core -> p_dubbo2 [style=dashed, color="#2e7d32"];
    core -> p_dubbo3 [style=dashed, color="#2e7d32"];
    core -> p_netty [style=dashed, color="#2e7d32"];
    core -> p_okhttp [style=dashed, color="#2e7d32"];
    core -> p_fastjson [style=dashed, color="#2e7d32"];
    core -> p_jackson [style=dashed, color="#2e7d32"];
    core -> p_kafka [style=dashed, color="#2e7d32"];
    core -> p_rabbit [style=dashed, color="#2e7d32"];
    core -> p_logger [style=dashed, color="#2e7d32"];
    core -> p_hot [style=dashed, color="#2e7d32"];
    core -> p_jfr [style=dashed, color="#2e7d32"];
    core -> p_mic [style=dashed, color="#2e7d32"];
    core -> p_prof [style=dashed, color="#2e7d32"];

    // 链式继承
    p_tc10 -> p_tc9  [label="依赖 9.x"];
    p_hc4  -> p_hc3  [label="依赖 3.x"];
    p_hc5  -> p_hc4  [label="依赖 4.x"];
    p_sp6  -> p_sp5  [label="复用 5.x"];

    t_agent -> core [style=dotted, color="#ef6c00", label="验证"];

    // 图例
    subgraph cluster_legend {
        label="图例";
        style="rounded";
        l1 [label="调用", shape=plaintext, fillcolor="white"];
        l2 [label="依赖", shape=plaintext, fillcolor="white"];
        l3 [label="运行时注入", shape=plaintext, fillcolor="white"];
    }
}
